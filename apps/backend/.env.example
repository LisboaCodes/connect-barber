# Aplicação
NODE_ENV=development
PORT=3000
TRUST_PROXY=2
# URL(s) do frontend (CORS), separadas por vírgula
FRONTEND_URL=http://localhost:5173
# domínio base da plataforma (CORS para subdomínios)
PLATFORM_DOMAIN=

# Banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/connect_barber?schema=public

# JWT
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=12h

# Superadmin da plataforma (criado/atualizado pelo seed)
ADMIN_EMAIL=admin@connectbarber.app
ADMIN_PASSWORD=admin123
# Cria a "Barbearia Demo" (dono@barbeariademo.com / 123456) se true
SEED_DEMO=false

# E-mail (Resend)
RESEND_API_KEY=
FROM_EMAIL=Connect Barber <noreply@seudominio.com>

# WhatsApp (Evolution API)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# Cobrança (CreativePay) - checkout hospedado + webhook
CREATIVE_PAY_BASE_URL=
CREATIVE_PAY_API_KEY=
CREATIVE_PAY_WEBHOOK_SECRET=

# Desliga as rotinas automáticas (lembretes etc.) em dev
DISABLE_CRON=false
